ENVIRONMENT=development
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/flowdesk
SUPABASE_URL=
SUPABASE_ANON_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MAX_TOKENS=500
GROQ_TEMPERATURE=0.7
GROQ_HISTORY_LIMIT=10
GROQ_SYSTEM_PROMPT=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# n8n Orchestration
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=change-me-in-production
N8N_ENABLED=false
N8N_MODE=disabled
INTERNAL_API_KEY=change-me-in-production
ESCALATION_KEYWORDS=humano,asesor,agente,representante,persona,quiero hablar con un

# Future PostgreSQL for n8n (SQLite by default)
# Uncomment below when migrating from SQLite to PostgreSQL
# N8N_DB_TYPE=postgresdb
# N8N_DB_HOST=
# N8N_DB_PORT=5432
# N8N_DB_DATABASE=
# N8N_DB_USER=
# N8N_DB_PASSWORD=
